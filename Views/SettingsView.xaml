<UserControl x:Class="GameSnapPlugin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="620">

    <UserControl.Resources>
        <Style x:Key="TipLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="20,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- Folders -->
            <TextBlock Text="Folders" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Source folder (Game Bar / ShareX output):" Margin="0,0,0,4">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <TextBlock MaxWidth="300" TextWrapping="Wrap"
                                           Text="The folder where your capture tool saves screenshots. GameSnap watches this folder in real time and moves files as they arrive.&#x0a;&#x0a;Xbox Game Bar: Settings → Gaming → Captures&#x0a;ShareX: Task Settings → Override Screenshots Folder"/>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox Text="{Binding Settings.SourceFolder, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Full path to the folder where your capture tool drops screenshots."/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Padding="10,4"
                        Command="{Binding BrowseSourceCommand}"/>
            </Grid>

            <TextBlock Text="Additional source folders (one per line):" Margin="0,0,0,4">
                <TextBlock.ToolTip>
                    <ToolTip>
                        <TextBlock MaxWidth="300" TextWrapping="Wrap"
                                   Text="Optional extra folders to monitor. Useful if you use multiple capture tools that save to different locations (e.g. ShareX and Game Bar simultaneously)."/>
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
            <TextBox Text="{Binding AdditionalSourcesText, UpdateSourceTrigger=PropertyChanged}"
                     Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,8"
                     ToolTip="One folder path per line. All folders are monitored with the same rules as the primary source folder."/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Destination base folder (game subfolders live here):" Margin="0,0,0,4">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <TextBlock MaxWidth="300" TextWrapping="Wrap"
                                           Text="The parent folder that contains one subfolder per game.&#x0a;&#x0a;Example structure:&#x0a;  D:\Screenshots\&#x0a;    Elden Ring\&#x0a;    Cyberpunk 2077\&#x0a;    Celeste\&#x0a;&#x0a;GameSnap matches screenshots to these subfolders automatically."/>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBox Text="{Binding Settings.DestinationBase, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Parent folder containing your per-game subfolders."/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Padding="10,4"
                        Command="{Binding BrowseDestinationCommand}"/>
            </Grid>

            <Separator Margin="0,8,0,12"/>

            <!-- Detection -->
            <TextBlock Text="Detection" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="Use Playnite game detection (recommended)"
                      IsChecked="{Binding Settings.UsePlayniteDetection}"
                      Margin="0,0,0,4"
                      ToolTip="When a game is running in Playnite, screenshots are automatically assigned to that game. Also learns aliases for future use without Playnite running."/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="Assigns screenshots to the currently running game and learns the alias automatically."/>

            <CheckBox Content="Use active window fallback"
                      IsChecked="{Binding Settings.UseWindowFallback}"
                      Margin="0,0,0,4"
                      ToolTip="If Playnite detection is off or no game is running, GameSnap reads the active window title and tries to match it to a game folder. Less reliable than Playnite detection."/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="Secondary detection using the active window title. Less reliable — use Playnite detection when possible."/>

            <CheckBox Content="Auto-create game folders when a game starts"
                      IsChecked="{Binding Settings.AutoCreateFolders}"
                      Margin="0,0,0,4"
                      ToolTip="Automatically creates a subfolder in the destination base using the game name from Playnite whenever you start playing a game for the first time. Disabled by default."/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="Disabled by default. Creates the game folder on first play — no manual folder creation needed."/>

            <Separator Margin="0,4,0,12"/>

            <!-- Unmatched -->
            <TextBlock Text="Unmatched Files" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="Move unmatched screenshots to a separate folder"
                      IsChecked="{Binding Settings.MoveUnmatchedToFolder}"
                      Margin="0,0,0,4"
                      ToolTip="Instead of leaving unrecognized screenshots in the source folder, moves them to a dedicated folder so you can review and assign them later using the Review window (Extensions → GameSnap → Review unmatched screenshots)."/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="Use 'Review unmatched screenshots' from the GameSnap menu to assign them to games manually."/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Folder name:" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="Name of the subfolder created inside the destination base for unmatched files."/>
                <TextBox Width="160"
                         Text="{Binding Settings.UnmatchedFolderName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Default: _Unmatched. The folder is created automatically inside the destination base."/>
            </StackPanel>

            <Separator Margin="0,4,0,12"/>

            <!-- Notifications -->
            <TextBlock Text="Notifications" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="Show Playnite notification when screenshots are organized"
                      IsChecked="{Binding Settings.ShowNotifications}"
                      Margin="0,0,0,4"
                      ToolTip="Shows a notification in Playnite's notification area (bell icon) with a summary of how many screenshots were organized and which games they went to."/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="Example: 'Organized 3 screenshot(s): Elden Ring (2) | Celeste (1)'"/>

            <Separator Margin="0,4,0,12"/>

            <!-- Rename -->
            <TextBlock Text="Rename Pattern" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <TextBox Text="{Binding Settings.RenamePattern, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,4"
                     ToolTip="Pattern used to rename screenshots when moving them. Use tokens to build the filename.&#x0a;&#x0a;Tokens:&#x0a;  {game}     → game folder name&#x0a;  {date}     → yyyy-MM-dd&#x0a;  {time}     → HH_mm_ss&#x0a;  {datetime} → yyyy-MM-dd_HH_mm_ss&#x0a;  {original} → original filename without extension"/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="Tokens: {game} {date} {time} {datetime} {original}&#x0a;Example: {game}_{date}_{time} → EldenRing_2026-05-20_14_30_00.png"/>

            <Separator Margin="0,4,0,12"/>

            <!-- Backup -->
            <TextBlock Text="Backup" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="Enable automatic backup (disabled by default)"
                      IsChecked="{Binding Settings.EnableBackup}"
                      Margin="0,0,0,4"
                      ToolTip="After moving a screenshot to its game folder, GameSnap also copies it to the backup folder. Useful for cloud drives or external HDDs. Disabled by default."/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="Copies each organized screenshot to the backup folder after moving. Mirrors the same game subfolder structure."/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Backup folder:" Margin="0,0,0,4"
                               ToolTip="Destination for backup copies. Can be a cloud-synced folder (Google Drive, OneDrive) or an external drive."/>
                    <TextBox Text="{Binding Settings.BackupFolder, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Full path to the backup destination folder."/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Padding="10,4"
                        Command="{Binding BrowseBackupCommand}"/>
            </Grid>

            <Separator Margin="0,4,0,12"/>

            <!-- Local Provider -->
            <TextBlock Text="Screenshots Utilities Local Provider" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="Register destination folder in Local Provider (disabled by default)"
                      IsChecked="{Binding Settings.EnableLocalProviderIntegration}"
                      Margin="0,0,0,4"
                      ToolTip="Automatically adds GameSnap's destination folder to the Screenshots Utilities Local Provider config. This makes your organized screenshots appear in the fullscreen viewer (e.g. Aniki Remake theme) without any manual setup in that plugin. Requires Screenshots Utilities Local Provider to be installed."/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="Requires the 'Screenshots Utilities Local Provider' plugin by HerrKnarz. Enables fullscreen screenshot viewing in themes like Aniki Remake."/>

            <Separator Margin="0,4,0,12"/>

            <!-- Emulators -->
            <TextBlock Text="Emulator Screenshots" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="Enable emulator screenshot support (disabled by default)"
                      IsChecked="{Binding Settings.EnableEmulatorSupport}"
                      Margin="0,0,0,4"
                      ToolTip="Monitors known emulator screenshot folders (RetroArch, PCSX2, Dolphin, DuckStation, PPSSPP, Cemu) and moves screenshots to the matching game folder. Game names are resolved using the ROM/disc name and your Playnite library. Disabled by default."/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="Auto-detects RetroArch, PCSX2, Dolphin, DuckStation, PPSSPP and Cemu. Add custom emulator folders below if yours is not listed."/>

            <TextBlock Text="Custom emulator screenshot folders (one per line):" Margin="0,0,0,4"
                       ToolTip="Add any emulator screenshot folder not auto-detected. One path per line."/>
            <TextBox Text="{Binding CustomEmulatorFoldersText, UpdateSourceTrigger=PropertyChanged}"
                     Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,12"
                     ToolTip="Example: C:\Emulators\RPCS3\screenshots"/>

            <Separator Margin="0,4,0,12"/>

            <!-- Steam -->
            <TextBlock Text="Steam Screenshots" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <CheckBox Content="Enable Steam screenshot support (disabled by default)"
                      IsChecked="{Binding Settings.EnableSteamSupport}"
                      Margin="0,0,0,4"
                      ToolTip="Monitors Steam's userdata folder and moves screenshots to the matching game folder in your destination base. GameSnap uses your Playnite library to resolve Steam AppIDs to game names — no API key needed. Disabled by default."/>
            <TextBlock Style="{StaticResource TipLabel}"
                       Text="Reads from Steam's userdata folder. Game names are resolved using your Playnite library — only works for games already added to Playnite."/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Steam path (leave empty to auto-detect):" Margin="0,0,0,4"
                               ToolTip="Leave empty to detect Steam automatically from the Windows registry. Only set this manually if auto-detection fails."/>
                    <TextBox Text="{Binding Settings.SteamPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Example: C:\Program Files (x86)\Steam"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom"
                        Margin="8,0,0,0" Padding="10,4"
                        Command="{Binding BrowseSteamCommand}"/>
            </Grid>

            <Separator Margin="0,4,0,12"/>

            <!-- Polling -->
            <TextBlock Text="Polling interval (seconds):" Margin="0,0,0,4"
                       ToolTip="How often GameSnap does a full scan of the source folder as a backup, in addition to the real-time file watcher. Increase this value if you notice high CPU usage."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Width="60"
                         Text="{Binding Settings.PollingIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Default: 30 seconds. The file watcher handles most cases instantly — polling is just a safety net."/>
                <TextBlock Text="  (backup scan in addition to real-time file watcher)"
                           VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>

            <Separator Margin="0,4,0,12"/>

            <!-- Extensions -->
            <TextBlock Text="File Extensions" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <TextBlock Text="Image extensions (comma separated):" Margin="0,0,0,4"
                       ToolTip="File extensions treated as images. These are moved directly to the game folder."/>
            <TextBox Margin="0,0,0,8"
                     Text="{Binding ImageExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Default: .png, .jpg, .jpeg"/>

            <TextBlock Text="Video extensions (comma separated):" Margin="0,0,0,4"
                       ToolTip="File extensions treated as videos. These are moved to a 'Videos' subfolder inside the game folder."/>
            <TextBox Margin="0,0,0,12"
                     Text="{Binding VideoExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Default: .mp4, .wmv — moved to GameFolder\Videos\"/>

            <Separator Margin="0,4,0,12"/>

            <!-- Tools -->
            <TextBlock Text="Tools" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Open dictionary.txt" Padding="10,6" Margin="0,0,8,0"
                        Command="{Binding OpenDictionaryCommand}"
                        ToolTip="Opens the alias dictionary in Notepad. Add custom mappings between filename prefixes and game names. GameSnap also writes to this file automatically when it learns new aliases."/>
                <Button Content="Open log" Padding="10,6"
                        Command="{Binding OpenLogCommand}"
                        ToolTip="Opens the GameSnap log file. Shows all moves, learned aliases, fallback detections, and errors. Useful for debugging unmatched files."/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
